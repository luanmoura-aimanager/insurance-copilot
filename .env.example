# Copy to .env and adjust as needed.
# Local dev points at the Postgres from docker-compose (host port 5433).
# Note the async driver: postgresql+asyncpg (not plain postgresql).
DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5433/insurance

# Read-only role (migration 4b285ffad59b) — used by the SQL worker / MCP query path.
# GRANT SELECT only; a write is physically impossible even if the text filter is bypassed.
# The password must match the RO_ROLE_PASSWORD used when the migration ran (put the real
# value only in .env, never here).
DATABASE_URL_RO=postgresql://insurance_ro:CHANGE_ME@localhost:5433/insurance

# Bearer tokens do POST /ask — "nome:token,nome2:token2". O nome identifica o cliente
# (aparece na chave do rate limit); o token é o segredo. Gere com `openssl rand -hex 32`
# e ponha o valor real só no .env. Vazio/ausente => /ask devolve 500 (fail closed).
API_TOKENS=whatsapp:CHANGE_ME_TOKEN_1,dev:CHANGE_ME_TOKEN_2

# Chave da Voyage — usada só pela indexação de vetores (scripts/embed_chunks.py).
# Modelo: voyage-4-lite, 1024 dimensões (a dimensão está no tipo da coluna
# `clause_chunk.embedding`, então trocar de modelo é migration, não config).
# Lida em runtime; ausente/vazia => a passada de embedding falha alto antes de gastar.
# Ponha o valor real só no .env. https://dashboard.voyageai.com/
VOYAGE_API_KEY=CHANGE_ME

# Rate limit do /ask, sintaxe da lib `limits` ("N/second|minute|hour|day").
# Por cliente: teto de consumo (cada hop do supervisor é uma chamada paga à Anthropic).
# Por IP: proteção de burst, vale mesmo se um token vazar.
ASK_RATE_LIMIT_CLIENT=30/hour
ASK_RATE_LIMIT_IP=10/minute

# --- Superfície do WhatsApp (Meta Cloud API) ---------------------------------
# As duas primeiras vão VAZIAS aqui de propósito: são a única barreira do primeiro
# endpoint público do projeto, e um `cp .env.example .env` com placeholder deixaria de
# pé um webhook cujo segredo está publicado no repositório. Vazias, o webhook devolve
# 500 até alguém pôr o valor de verdade. (O código também trata CHANGE_ME* como
# ausente, pra quem copiar da documentação em vez do arquivo.)
#
# São lidas em runtime; ausentes/vazias => o webhook devolve 500
# (fail closed na CONFIGURAÇÃO, como o API_TOKENS) e NÃO 403 — um 403 faria um deploy
# quebrado parecer "a Meta mandou assinatura errada". Ponha o valor real só no .env.

# Token do handshake de verificação (GET /webhook/whatsapp). Você escolhe o valor e
# repete no painel da Meta ao cadastrar a URL. Gere com `openssl rand -hex 32`.
WHATSAPP_VERIFY_TOKEN=

# App Secret do app da Meta (Configurações > Básico). É a chave do HMAC-SHA256 que
# assina CADA POST, no header X-Hub-Signature-256 — é o que prova que o corpo veio da
# Meta e chegou íntegro. A rota é pública, então esta é a única barreira dela.
WHATSAPP_APP_SECRET=

# Rate limit do POST /webhook/whatsapp, sintaxe da lib `limits`. Só APERTA: a rota tem
# uma âncora estática de 600/minute avaliada junto, que valor de env nenhum levanta
# (ver app/limits.py::whatsapp_limit).
WHATSAPP_RATE_LIMIT=120/minute
